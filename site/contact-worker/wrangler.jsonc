// The contact form's backend. site.yml deploys it from main; CONTACT_TO is a secret (the verified Email Routing
// destination), set from the OWNER_CONTACT_TO repository secret.
{
  "name": "deckconnector-contact",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "deckconnector.com/api/contact", "zone_name": "deckconnector.com" }],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": { "ORIGIN": "https://deckconnector.com" },
}
