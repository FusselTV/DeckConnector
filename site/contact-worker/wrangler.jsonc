// The contact form's backend. site.yml deploys it from main with the secrets CONTACT_TO, SMTP_USER, SMTP_PASS and TURNSTILE_SECRET
// (iCloud app-specific password), from OWNER_CONTACT_TO, OWNER_SMTP_USER, OWNER_SMTP_PASS and OWNER_TURNSTILE_SECRET.
{
  "name": "deckconnector-contact",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "deckconnector.com/api/contact", "zone_name": "deckconnector.com" }],
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": { "ORIGIN": "https://deckconnector.com" },
  "observability": { "enabled": true },
}
