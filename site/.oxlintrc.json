{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../web/.oxlintrc.json"],
  "plugins": ["eslint", "typescript", "react", "jsx-a11y", "oxc", "nextjs"],
  "ignorePatterns": [".next", ".source", "out", "public", "next-env.d.ts"],
  "rules": {
    "nextjs/no-html-link-for-pages": "off"
  }
}
