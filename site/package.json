{
  "name": "deckconnector-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-firmware.mjs && node scripts/copy-demo.mjs && next dev",
    "build": "node scripts/copy-firmware.mjs && node scripts/copy-demo.mjs && next build && node scripts/de-404.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && node --test scripts/llms.test.mjs scripts/search.test.mjs scripts/links.test.mjs scripts/flash-unit.test.mjs contact-worker/mail.test.mjs",
    "test:flash": "node --test scripts/flash-unit.test.mjs scripts/flash-e2e.test.mjs"
  },
  "dependencies": {
    "@remotion/player": "4.0.543",
    "esptool-js": "0.7.1",
    "fumadocs-core": "16.19.0",
    "fumadocs-mdx": "15.6.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "zbsearch": "4.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
