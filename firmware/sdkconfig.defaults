CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_APP_PROJECT_VER_FROM_CONFIG=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Updates: two app slots, roll back when the new image does not confirm itself
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Memory: big buffers go to PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
# EXT_RAM_BSS_ATTR: the per-deck state is zero from the start and lives in PSRAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# the 32 MB self test took 0.84 s of every boot
CONFIG_SPIRAM_MEMTEST=n

# Network
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
# The receive ring must hold a whole window, or a sender bursts past it and segments are sent again (0.2 MB/s
# instead of 6.5 MB/s once). One frame per buffer: 20 frames, a 16-segment window. With 8640 a Companion page
# (~25 KB) took the window to 0 on every switch. 32 KB with 30 buffers took the lowest free heap to 82 KB under
# a full-screen stream plus eight HTTP clients, this to 111 KB. About 30 KB of that is the larger DMA buffers
# (internal RAM, kept for good), the rest is received data waiting in each busy socket (up to ~24 KB each).
CONFIG_ETH_DMA_BUFFER_SIZE=1536
# Five send buffers instead of ten: 10 KB more free heap, the page and screen.jpg as fast
CONFIG_ETH_DMA_TX_BUFFER_NUM=5
CONFIG_LWIP_TCP_WND_DEFAULT=23040
# Unacked data of each socket waits in internal RAM: with 32 KB, eight clients polling screen.jpg took the lowest
# free heap from 171 to 69 KB. Eight segments keep the page and screen.jpg as fast as before.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_MAX_SOCKETS=40
CONFIG_LWIP_MAX_ACTIVE_TCP=40
# connections that arrive together wait here for accept; a full box answers with a reset
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=16
# TIME-WAIT is 2 MSL. lwIP ignores the RST a client sends when it reuses a port the bridge still holds there,
# so that client's connect hangs until TIME-WAIT ends: 120 s with the default MSL.
CONFIG_LWIP_TCP_MSL=1000
# the address comes seconds sooner: no ARP probe of the offered address, and the last one is asked for first
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
# a browser sends every cookie of a shared parent domain (deck.example.com behind a proxy)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=8192

# The co-processor (ESP32-C6) gives the P4 its WLAN
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_WIFI_RMT_STATIC_TX_BUFFER=y
CONFIG_WIFI_RMT_STATIC_TX_BUFFER_NUM=16

# Per task stack watermarks in /api/status, CPU per task in /api/profile
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# db_net decides when WLAN answers mDNS
CONFIG_MDNS_PREDEF_NETIF_STA=n
# the API, two Satellite names, and per deck its dock and its device: 11 with four decks
CONFIG_MDNS_MAX_SERVICES=12

# /api/ws
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# Deeper JSON overflows the parser's stack: 127 nested brackets restarted the bridge
CONFIG_CJSON_NESTING_LIMIT=16

# HTTPS on 443 next to HTTP, with a certificate made on the device. TLS buffers in PSRAM: about 25 KB per
# connection that internal RAM cannot spare.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_ESP_TLS_SERVER_SESSION_TICKETS=y
# a new address gets a new certificate without restarting HTTPS
CONFIG_ESP_TLS_SERVER_CERT_SELECT_HOOK=y
CONFIG_ESP_HTTPS_SERVER_CERT_SELECT_HOOK=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
# wss:// links: the 41 most used CAs (Let's Encrypt among them), 16 KB instead of 66 KB for all
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y
# A CPU that runs no idle task for 5 s restarts the bridge instead of only logging it
CONFIG_ESP_TASK_WDT_PANIC=y
# A flash erase or write rests 50 ms after every 100 (one 64 KB erase takes about 110): meanwhile the other
# core waits with its cache off. With the default 1 ms after 20, its tasks fell behind during an update and
# kept its idle task off it for 5 s.
CONFIG_SPI_FLASH_ERASE_YIELD_DURATION_MS=100
CONFIG_SPI_FLASH_ERASE_YIELD_TICKS=50

# Matter: the bridge joins the network itself and Matter commissions over it, without BLE and without its own WLAN
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ENABLE_CHIPOBLE=n
CONFIG_ENABLE_ETHERNET_TELEMETRY=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
# 2 for Matter itself, mDNS twice (its restart opens new sockets before queued packets free the old):
# LAN v4+v6, WLAN v4+v6, setup AP v4
CONFIG_NUM_UDP_ENDPOINTS=12
# Matter's TCP/IP core lock slowed a competitor's redraws
CONFIG_USE_TCPIP_CORE_LOCK_FOR_THREAD_SAFETY=n
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_CUSTOM_COMMISSIONABLE_DATA_PROVIDER=y
# root, aggregator, four Stream Deck + XL of a node and 62 switches each; esp-matter keeps it below 256
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=255
CONFIG_ESP_MATTER_NVS_PART_NAME="matter"
CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="matter"
CONFIG_CHIP_CONFIG_NAMESPACE_PARTITION_LABEL="matter"
CONFIG_CHIP_COUNTERS_NAMESPACE_PARTITION_LABEL="matter"
CONFIG_CHIP_KVS_NAMESPACE_PARTITION_LABEL="matter"
