// Writes mirabox_ref.h from Bitfocus' companion-surface-mirabox-stream-dock (MIT):
//   node mirabox_ref.mts <checkout> > mirabox_ref.h
// Its own StreamDock class runs against a fake HID device; the reports it writes are the reference.
import { registerHooks } from 'node:module'
import { pathToFileURL } from 'node:url'

const root = process.argv[2]
registerHooks({
  resolve(spec, ctx, next) {
    if (spec === '@julusian/jpeg-turbo') return { url: 'stub:jpeg', shortCircuit: true }
    if (spec.startsWith('.') && spec.endsWith('.js')) return next(spec.slice(0, -3) + '.ts', ctx)
    return next(spec, ctx)
  },
  load(url, ctx, next) {
    if (url === 'stub:jpeg')
      return { format: 'module', shortCircuit: true, source: 'export default { compress: async () => globalThis.jpeg }' }
    return next(url, ctx)
  },
})
const { StreamDock } = await import(pathToFileURL(`${root}/src/streamdock.ts`).href)
const { AllModels } = await import(pathToFileURL(`${root}/src/models/list.ts`).href)

type Model = (typeof AllModels)[number]
const out: string[] = []
const hex = (b: Uint8Array) => Array.from(b, (x) => '0x' + x.toString(16).padStart(2, '0')).join(',')

function record(model: Model, run: (d: any) => Promise<void>): Promise<Buffer[]> {
  const reports: Buffer[] = []
  const hid = { on() {}, write: async (b: Buffer) => (reports.push(b.subarray(1)), b.length), close: async () => {} }
  const d = new StreamDock({ path: 'x', serialNumber: 'x' }, hid, model)
  return run(d).then(async () => {
    await new Promise((r) => setTimeout(r, 0))
    clearInterval(d.heartbeatInterval)
    return reports
  })
}

const vectors: string[] = []
async function vector(name: string, model: Model, run: (d: any) => Promise<void>) {
  const reports = await record(model, run)
  const rows = reports.map((r) => {
    let n = r.length
    while (n && !r[n - 1]) n--
    return `{${n}, (const uint8_t[]){${hex(r.subarray(0, Math.max(n, 1)))}}}`
  })
  vectors.push(`    {"${name}", ${model.packetSize ?? 1024}, ${rows.length}, (const ref_report_t[]){\n        ${rows.join(',\n        ')}}},`)
}

const big = AllModels.find((m: Model) => m.productName === 'Stream Dock 293V3')
const small = AllModels.find((m: Model) => m.packetSize === 512)
const pattern = (n: number) => Buffer.from(Array.from({ length: n }, (_, i) => (i * 7 + 3) & 0xff))
for (const m of [big, small]) {
  const p = m.packetSize ?? 1024
  await vector('heartbeat', m, (d) => d.sendHeartbeat())
  await vector('wake', m, (d) => d.wakeScreen())
  await vector('clear', m, (d) => d.clearPanel())
  await vector('led_off', m, (d) => d.setLedBrightness(0))
  for (const b of [0, 1, 7, 50, 99, 100]) await vector(`brightness_${b}`, m, (d) => d.setBrightness(b))
  const o = m.outputs.find((x: any) => x.type === 'lcd')
  for (const n of [1, p, p + 1, 3 * p - 5]) {
    await vector(`image_${n}`, m, (d) => ((globalThis as any).jpeg = pattern(n), d.setKeyImage(o.column, o.row, Buffer.alloc(0))))
  }
}

const curve: number[] = []
for (let b = 0; b <= 100; b++) curve.push((await record(big, (d) => d.setBrightness(b)))[0][10])

const kinds = ['button', 'push', 'rotateLeft', 'rotateRight', 'swipeLeft', 'swipeRight']
const models = AllModels.filter((m: Model) => m.usbIds.length).map((m: Model) => {
  const ids = m.usbIds.flatMap((u: any) => u.productIds.map((p: number) => `{0x${u.vendorId.toString(16)}, 0x${p.toString(16)}}`))
  const outs = m.outputs.filter((x: any) => x.type === 'lcd').map((x: any) => `{${x.row}, ${x.column}, 0x${x.id.toString(16)}, ${x.resolutionx}, ${x.resolutiony}}`)
  const ins = m.inputs.map((x: any) => `{${x.row}, ${x.column}, 0x${x.id.toString(16)}, ${kinds.indexOf(x.type)}}`)
  return `    {"${m.productName}", ${m.iconRotation}, ${m.packetSize ?? 1024}, ${ids.length}, (const ref_id_t[]){${ids.join(', ')}},\n` +
    `     ${outs.length}, (const ref_out_t[]){${outs.join(', ')}},\n` +
    `     ${ins.length}, (const ref_in_t[]){${ins.join(', ')}}},`
})

out.push(`/* Generated by mirabox_ref.mts from companion-surface-mirabox-stream-dock (MIT, Bitfocus AS). */
#pragma once

#include <stdint.h>

typedef struct {
    uint16_t len; /* up to the last nonzero byte; the rest of the report is zero */
    const uint8_t *b;
} ref_report_t;

typedef struct {
    const char *name;
    uint16_t packet;
    uint8_t count;
    const ref_report_t *r;
} ref_vector_t;

typedef struct {
    uint16_t vid, pid;
} ref_id_t;

typedef struct {
    uint8_t row, col, id;
    uint16_t w, h;
} ref_out_t;

enum { REF_BUTTON, REF_PUSH, REF_LEFT, REF_RIGHT, REF_SWIPE_LEFT, REF_SWIPE_RIGHT };

typedef struct {
    uint8_t row, col, id, kind;
} ref_in_t;

typedef struct {
    const char *name;
    int rotation; /* iconRotation */
    uint16_t packet;
    uint8_t id_count;
    const ref_id_t *ids;
    uint8_t out_count;
    const ref_out_t *out;
    uint8_t in_count;
    const ref_in_t *in;
} ref_model_t;

static const ref_vector_t ref_vectors[] = {
${vectors.join('\n')}
};

static const uint8_t ref_brightness[101] = {${curve.join(', ')}};

static const ref_model_t ref_models[] = {
${models.join('\n')}
};
`)
process.stdout.write(out.join(''))
