# Off on purpose: memcpy_s and friends (C11 Annex K) exist in neither newlib nor glibc; trailing commas fight
# clang-format; padding and operator precedence hints are noise for this code; chained ?: reads as a table here.
# Comparisons yield int and uint8_t promotes to int in C, so the bool-conversion and signed-bitwise checks only flag
# correct C. ESP-IDF passes numbers through void * task and callback arguments, and its flag enums take OR-ed values.
# The bounds checker cannot see lwIP's socket numbers in FD_SET or the counts the Wi-Fi scan returns. Enums mark
# ranges (K_FIELD0 + field), int8_t tables hold -1, typeof() needs its parentheses, and FreeRTOS.h includes itself.
# A memcmp of two structs asks whether any byte changed: padding can only cause one redraw or restart too many.
# components/db_core/.clang-tidy adds the stricter checks for the plain C core.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-assignment-in-if-condition,
  -bugprone-assignment-in-selection-statement,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-unchecked-string-to-number-conversion,
  -bugprone-signed-char-misuse,
  -bugprone-suspicious-memory-comparison,
  cert-*,
  -cert-err33-c,
  -cert-err34-c,
  -cert-exp42-c,
  -cert-flp37-c,
  -cert-int09-c,
  -cert-str34-c,
  -cert-exp45-c,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-security.ArrayBound,
  -clang-analyzer-security.insecureAPI.strcpy,
  misc-*,
  -misc-include-cleaner,
  -misc-header-include-cycle,
  -misc-unused-parameters,
  performance-*,
  -performance-no-int-to-ptr,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-avoid-unconditional-preprocessor-if,
  -readability-enum-initial-value,
  -readability-redundant-parentheses,
  -readability-function-cognitive-complexity,
  -readability-function-size,
  -readability-isolate-declaration,
  -readability-uppercase-literal-suffix,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-optin.performance.Padding,
  -readability-trailing-comma,
  -readability-math-missing-parentheses,
  -readability-avoid-nested-conditional-operator,
  -readability-implicit-bool-conversion,
  -bugprone-signed-bitwise
WarningsAsErrors: '*'
CheckOptions:
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.VariableIgnoredRegexp
    value: '^[A-Z][A-Z0-9_]*$'
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
HeaderFilterRegex: 'components/db_.*'
