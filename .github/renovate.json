{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "schedule": ["* 0-5 1 * *"],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": { "enabled": true, "schedule": ["* 0-5 1 * *"] },
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"], "groupName": "all non-major" },
    {
      "description": "firmware/vendor/esp_hal_usb is a patched copy of this version's USB HAL. Update both and test on a board.",
      "matchPackageNames": ["espressif/idf"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The firmware needs a board test after any component update.",
      "matchDatasources": ["custom.espressif"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Python tools the workflows run by version",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "uvx (?<depName>[\\w-]+)@(?<currentValue>[\\d.]+)",
        "(?:pipx run|pip install -q) (?<depName>[\\w-]+)==(?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Docker images the workflows run, by tag and digest",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "(?<depName>[a-z0-9]+/[a-z0-9._-]+):(?<currentValue>v?[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "npm tools the workflows run by version",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["npx -y (?<depName>@?[\\w/.-]+)@(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "ESP-IDF components of the firmware. Only updates outside the range show up: idf.py update-dependencies moves dependencies.lock",
      "managerFilePatterns": ["/^firmware/.+/idf_component\\.yml$/"],
      "matchStrings": ["(?<depName>espressif/[\\w-]+):\\s*(?:\\n\\s+version:\\s*)?\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "custom.espressif",
      "versioningTemplate": "npm"
    }
  ],
  "customDatasources": {
    "espressif": {
      "defaultRegistryUrlTemplate": "https://components.espressif.com/api/components/{{packageName}}",
      "transformTemplates": [
        "{\"releases\": versions[yanked_at = null].{\"version\": version, \"releaseTimestamp\": created_at}}"
      ]
    }
  }
}
