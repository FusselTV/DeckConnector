{
  "name": "deckconnector-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sim": "node scripts/sim.mjs",
    "build": "tsc -b && vite build && node scripts/size.mjs",
    "build:demo": "node scripts/deck-ui.mjs && tsc -b && vite build --mode demo",
    "dev:demo": "node scripts/deck-ui.mjs && vite --mode demo",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/deck-ui.mjs && vitest run",
    "e2e": "playwright test",
    "e2e:demo": "npm run build:demo && playwright test -c playwright.demo.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.1"
  }
}
